# ===== ChatConnect backend environment =====
# Copy this file to .env and fill in real values. Never commit .env to Git.

# MongoDB Atlas connection string (keep the database name if your URI includes one)
MONGODB_URI=your_mongodb_atlas_connection_string

# Long random secret used to sign JWTs (64+ characters recommended)
JWT_SECRET=replace_with_a_long_random_secret

# How long a login stays valid
JWT_EXPIRES_IN=7d

# Port the backend listens on
PORT=4000

# Frontend origin allowed by CORS (no trailing slash)
CLIENT_ORIGIN=http://localhost:5173

# development | production
NODE_ENV=development

# Set to true in production so the auth cookie is only sent over HTTPS.
# Cross-site (different domain) deployments also need SameSite=none, handled automatically when true.
COOKIE_SECURE=false

# Optional: override the cookie SameSite behavior. Lax (default) | Strict | None
COOKIE_SAMESITE=Lax
